clear
close all

t = linspace(-pi, pi, 50);
y = sin(t);

figure(1);
plot(t, y, 'r--');
xlabel('t'); ylabel('y');
title('y(t) = sin(t)');
legend('sin(t)');
grid on;

x  = linspace(-pi, pi, 50);
y1 = -x.^2 + 9;
y2 = x.^3 - 2*x.^2 - 9;

figure(2);
plot(x, y1, 'b-', x, y2, 'g--', 'LineWidth', 1.5);
xlabel('x'); ylabel('y');
title('Funkciju grafikai');
legend('y = -x^2 + 9', 'y = x^3 - 2x^2 - 9');
grid on;